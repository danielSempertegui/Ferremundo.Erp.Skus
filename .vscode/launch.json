{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ERP Skus API Development HTTPS",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Ferremundo.Erp.Skus.Api/bin/Debug/net10.0/Ferremundo.Erp.Skus.Api.dll",
      "cwd": "${workspaceFolder}/src/Ferremundo.Erp.Skus.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7178;http://localhost:5178"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "ERP Skus API QA HTTPS",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Ferremundo.Erp.Skus.Api/bin/Debug/net10.0/Ferremundo.Erp.Skus.Api.dll",
      "cwd": "${workspaceFolder}/src/Ferremundo.Erp.Skus.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "QA",
        "ASPNETCORE_URLS": "https://localhost:7278;http://localhost:5278"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "ERP Skus API Production HTTPS",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Ferremundo.Erp.Skus.Api/bin/Debug/net10.0/Ferremundo.Erp.Skus.Api.dll",
      "cwd": "${workspaceFolder}/src/Ferremundo.Erp.Skus.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Production",
        "ASPNETCORE_URLS": "https://localhost:7378;http://localhost:5378"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
