{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "Ferremundo.Erp.Skus.Api"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss.fff zzz} [{Level}] [{SourceContext}] [User:{UserName}] {Message} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:/Ferremundo/Microservices/Logs/Ferremundo.Erp.Skus.Api/Erp.Skus.Api-.txt",
          "rollingInterval": "Hour",
          "retainedFileCountLimit": null,
          "shared": true,
          "flushToDiskInterval": "00:00:01",
          "outputTemplate": "{Timestamp:HH:mm:ss.fff zzz} [{Level}] [{SourceContext}] [User:{UserName}] {Message} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341",
          "outputTemplate": "{Timestamp:HH:mm:ss.fff zzz} [{Level}] [{SourceContext}] [User:{UserName}] {Message} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Authentication": {
    "DefaultScheme": "Bearer"
  },
  "Ax2012": {
    "PricingService": {
      "EndpointAddress": "net.tcp://srv20131:8201/DynamicsAx/Services/FERRPriceServiceGroup",
      "UpnIdentity": "AdminAX@ferremundo.com.ec",
      "DefaultCompany": "fm",
      "DefaultDomain": "FERREMUNDO",
      "Language": "es",
      "PartitionKey": "initial",
      "SendTimeoutMinutes": 5,
      "CredentialMode": "None"
    }
  },
  "AllowedHosts": "*"
}
